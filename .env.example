# Public URL of the site (used for the download QR code and metadata)
NEXT_PUBLIC_SITE_URL=https://restorehealthservices.in

# Optional: override the APK file location. /download/apk redirects here.
# Defaults to the Cloudflare R2 link in lib/site.ts.
#   APK_DOWNLOAD_URL=https://downloads.restorehealthservices.in/restorehealthservices.apk
APK_DOWNLOAD_URL=

# Contact form email (Nodemailer, SMTP). Port 465 uses SSL; 587 uses STARTTLS.
# Google Workspace: smtp.gmail.com, 465, your address + an App Password
# Zoho Mail (India): smtppro.zoho.in, 465
# Hostinger: smtp.hostinger.com, 465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender address (defaults to SMTP_USER) and where enquiries are delivered
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=helpline@restorehealthservices.in
